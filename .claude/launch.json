{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "quant-web",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["app.py"],
      "port": 5000,
      "autoPort": true
    },
    {
      "name": "sauron",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "http.server", "5055", "--directory", "../sauron"],
      "port": 5055,
      "autoPort": true
    },
    {
      "name": "builder",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["../partner-portfolios/app.py"],
      "port": 5060,
      "autoPort": true
    }
  ]
}
