{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "quant-web",
      "runtimeExecutable": ".venv-mac/bin/python",
      "runtimeArgs": ["app.py"],
      "port": 5000,
      "autoPort": true
    },
    {
      "name": "vision",
      "runtimeExecutable": ".venv-mac/bin/python",
      "runtimeArgs": ["-m", "http.server", "5057", "--directory", "../vision"],
      "port": 5057,
      "autoPort": true
    },
    {
      "name": "builder",
      "runtimeExecutable": ".venv-mac/bin/python",
      "runtimeArgs": ["../partner-portfolios/app.py"],
      "port": 5060,
      "autoPort": true
    }
  ]
}
